provider:
  - fabric:
      - fabric_provider:
          credential_file: ~/.amscrot/credentials.yml
          profile: fabric
  - janus:
      - janus_provider:
          credential_file: ~/.amscrot/credentials.yml
          profile: janus
resource:
  - node:
      - ctrlr_node:
          provider: '{{ fabric.fabric_provider }}'
          # site: WASH  # Uncomment this otherwise site will be random
      - fabric_node:
          provider: '{{ fabric.fabric_provider }}'
          # site: MAX  # Uncomment this otherwise site will be random
          count: 1
  - service:
      - dtn_service:
          provider: '{{ janus.janus_provider }}'
          controller: '{{ node.ctrlr_node }}'
          node: ['{{ node.ctrlr_node }}', '{{ node.fabric_node }}']
          count: 0  # Set count to 1 to use janus dtn service
