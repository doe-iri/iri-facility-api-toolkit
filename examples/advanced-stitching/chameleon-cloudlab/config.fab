variable:
  - chi_device:
      default: Chameleon-TACC 
  - cloulab_device:
      default: CloudLab-Clemson # Utah-Cloudlab-Powder
  - node_count:
      default: 1
provider:
  - cloudlab:
      - cloudlab_provider:
          credential_file: ~/.fabfed/fabfed_credentials.yml
          profile: cloudlab
  - fabric:
      - fabric_provider:
          credential_file: ~/.fabfed/fabfed_credentials.yml
          profile: fabric
  - chi:
      - chi_provider:
          credential_file: ~/.fabfed/fabfed_credentials.yml
          profile: chi
  - janus:
      - janus_provider:
          credential_file: ~/.fabfed/fabfed_credentials.yml
          profile: janus
config:
  - layer3:
      - layer3_config:
          subnet: 192.168.1.0/24
resource:
  - network:
      - cnet:
          provider: '{{cloudlab.cloudlab_provider }}'
          layer3: '{{ layer3.layer3_config }}'
          profile: fabfed-test  # ON Cloudlab: add ../../fabfed_config/clouldlab_profile_sample.py and name it fabfed-test if not in fabfed clouldlab project.
      - fabric_network:
          provider: '{{ fabric.fabric_provider }}'
          layer3: '{{ layer3.layer3_config }}'
          stitch_with:
            - network: '{{ network.chi_network }}'
              stitch_option:
                device_name: '{{ var.chi_device }}'
            - network: '{{ network.cnet }}'
              stitch_option:
                device_name: '{{ var.cloulab_device }}'
      - chi_network:
          provider: '{{ chi.chi_provider }}'
          name: stitch_net
          layer3: '{{ layer3.layer3_config }}'
  - node:
      - cloudlab_node:
          provider: '{{ cloudlab.cloudlab_provider }}'
          network: '{{ network.cnet }}'
          count: '{{ var.node_count }}'
      - chi_node:
          provider: '{{ chi.chi_provider }}'
          network: '{{ network.chi_network }}'
          count: '{{ var.node_count }}'
  - service:
      - dtn_service:
          provider: '{{ janus.janus_provider }}'
          controller: '{{ node.cloudlab_node }}'
          node: ['{{ node.cloudlab_node  }}', '{{ node.chi_node }}']
          count: 0  # Set count to 1 to use janus dtn service


