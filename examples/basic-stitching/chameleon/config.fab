variable:
  - chi_device:
      default: Chameleon-TACC 
  - node_count:
      default: 1
provider:
  - fabric:
      - fabric_provider:
          credential_file: ~/.amscrot/credentials.yml
          profile: fabric
  - chi:
      - chi_provider:
          credential_file: ~/.amscrot/credentials.yml
          profile: chi
  - janus:
      - janus_provider:
          credential_file: ~/.amscrot/credentials.yml
          profile: janus
config:
  - layer3:
      - my_layer:
          subnet: 192.168.100.0/24
resource:
  - network:
      - chi_network:
          provider: '{{ chi.chi_provider }}'
          layer3: '{{ layer3.my_layer }}'
      - fabric_network:
          provider: '{{ fabric.fabric_provider }}'
          layer3: '{{ layer3.my_layer }}'
          # bw: 10
          stitch_with:
            - network: '{{ network.chi_network }}'
              stitch_option:
                device_name: '{{ var.chi_device }}'
  - node:
      - fabric_node:
          provider: '{{ fabric.fabric_provider }}'
          image: default_rocky_8
          network: '{{ network.fabric_network }}'
          count: '{{ var.node_count }}'
      - chi_node:
          provider: '{{ chi.chi_provider }}'
          image: CC-Ubuntu20.04
          network: '{{ network.chi_network }}'
          flavor: m1.medium
          count: '{{ var.node_count }}'
  - service:
      - dtn_service:
          provider: '{{ janus.janus_provider }}'
          node: ['{{ node.chi_node }}', '{{ node.fabric_node }}']
          controller: '{{ node.fabric_node }}'
          count: 1
