provider:
  - fabric:
      - fabric_provider:
          credential_file: ~/.amscrot/credentials.yml
          profile: fabric
  - kube:
      - kube_provider:

resource:
  - node:
      - ctrl-node:
          provider: '{{ fabric.fabric_provider }}'
          enable_fabnetv4: false
          enable_fabnetv6: false
          enable_fabnetv6ext: true
          routes: [2600:4040:7879:e00::/64]
          site: WASH  # Uncomment this otherwise site will be random
      - agent-node:
          provider: '{{ fabric.fabric_provider }}'
          enable_fabnetv4: false
          enable_fabnetv6: false
          enable_fabnetv6ext: true
          routes: [2600:4040:7879:e00::/64]
          site: WASH  # Uncomment this otherwise site will be random
          count: 2
  - service:
      - kube_service:
          provider: '{{ kube.kube_provider }}'
          controller: '{{ node.ctrl-node }}'
          flannel_iface: eth1
          flannel_ipv6_masq: true
          node: ['{{ node.ctrl-node }}', '{{ node.agent-node }}']
          count: 1  # Set count to 1 to enable kube service
          delete: 0 # Set delete to 1 to remove existing kube service
